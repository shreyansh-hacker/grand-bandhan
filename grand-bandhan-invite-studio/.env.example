# ==============================================================================
# Grand Bandhan Invite Studio - Environment Variables Reference (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or set these variables in 
# the Vercel Project Dashboard (Settings > Environment Variables).

# ------------------------------------------------------------------------------
# 1. AI Assistant Configuration (Server-Side)
# ------------------------------------------------------------------------------
# The AI Studio Assistant (api/ai.ts) analyzes draft content, suggests 
# cultural wording improvements, fixes missing fields, and returns preview diffs.
# Provide at least one valid key. If none are provided, the studio gracefully 
# falls back to a deterministic smart rule-based copy engine.

# Google Gemini API Key (Recommended default for bilingual Indian English/Hindi)
AI_API_KEY=your_gemini_or_ai_api_key_here
GEMINI_API_KEY=

# Optional alternative AI providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & Cloud Persistence (Server-Side)
# ------------------------------------------------------------------------------
# By default, Invite Studio stores drafts, published invites, and RSVPs in 
# localStorage with automatic client-side cloud synchronization.
# To enable persistent Supabase / PostgreSQL storage on Vercel:

# PostgreSQL connection string (e.g. Supabase, Neon Postgres, or Vercel Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase REST endpoint and service key
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. Public Client-Side Application Settings (Vite Prefix VITE_)
# ------------------------------------------------------------------------------
# Application branding and public URL for generating shareable links:
VITE_APP_URL=https://invite.grandbandhan.com
VITE_STUDIO_NAME="Grand Bandhan Invite Studio"
VITE_DEFAULT_LANGUAGE=en

# Optional Client-Accessible Supabase keys for direct client subscriptions
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
