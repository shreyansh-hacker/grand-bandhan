# Root Environment Variables Template

# Backend API
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (Neon PostgreSQL or Local PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/grand_bandhan?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-super-secure-access-jwt-secret-at-least-32-chars"
JWT_REFRESH_SECRET="your-super-secure-refresh-jwt-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Media Storage (Cloudinary - Optional for Hackathon / Production)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
