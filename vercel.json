{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter grand-bandhan-invite-studio run build",
  "outputDirectory": "grand-bandhan-invite-studio/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/grand-bandhan-invite-studio/api/$1"
    },
    {
      "source": "/i/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
