{
  "name": "@grand-bandhan/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"try { require('fs').cpSync('src/generated', 'dist/generated', { recursive: true }); } catch (e) { if (e.code !== 'EPERM') throw e; }\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@grand-bandhan/shared": "workspace:*",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
